PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexusllm?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string

# LLM Providers (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Rate Limiting
RATE_LIMIT_RPM=60

# Cache
CACHE_TTL_SECONDS=3600
